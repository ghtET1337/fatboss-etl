// FatBoss graffiti: one shader per design, drawn as a decal by the FatBoss cgame.
// Sharp regardless of r_picmip or texture compression; polygonOffset keeps it on the wall.

fatboss/graffiti/cloudy
{
	nopicmip
	nocompress
	polygonOffset
	sort decal
	{
		clampmap fatboss/graffiti/cloudy.png
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen vertex
		alphaGen vertex
	}
}

