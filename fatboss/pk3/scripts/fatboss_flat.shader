	nopicmip
	nocompress
	{
		map models/fatboss/skins/marble/thompson_gloss.jpg
		rgbGen lightingDiffuse
	}
	{
		map $whiteimage
		rgbGen const ( 0.195 0.199 0.204 )
		blendFunc GL_DST_COLOR GL_ZERO
	}
	{
		map models/fatboss/skins/marble/thompson_4k.jpg
		blendFunc GL_ONE GL_ONE
		rgbGen lightingDiffuse
	}
	{
		map fbs/wear/thompson.png
		alphaFunc GE128
		alphaGen entity
		rgbGen lightingDiffuse
	}
}

