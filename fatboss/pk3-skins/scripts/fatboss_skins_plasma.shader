// FatBoss weapon skins - generated by fatboss/skins/build_skins.py, do not edit

fatboss/skins/plasma/colt_4k
{
	nopicmip
	nocompress
	{
		map models/fatboss/skins/plasma/colt_gloss.jpg
		rgbGen lightingDiffuse
	}
	{
		map models/fatboss/skins/studio.jpg
		tcGen environment
		blendFunc GL_DST_COLOR GL_ZERO
	}
	{
		map models/fatboss/skins/plasma/colt_4k.jpg
		blendFunc GL_ONE GL_ONE
		rgbGen lightingDiffuse
	}
	{
		map fbs/wear/colt.png
		alphaFunc GE128
		alphaGen entity
		rgbGen lightingDiffuse
	}
	{
		map models/fatboss/skins/plasma/colt_glow.jpg
		blendFunc GL_ONE GL_ONE
		rgbGen identity
	}
}

